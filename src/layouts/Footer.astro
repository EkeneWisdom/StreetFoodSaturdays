---
import {
  FaGoogle,
  FaFacebookF,
  FaInstagram,
  FaWhatsapp,
} from "react-icons/fa6";

import { MessageCircle, Phone, Mail, MapPin, ArrowUpRight, ShieldCheck, ChevronRight } from "lucide-react";

import Container from "@/components/ui/Container";
import Logo from "@/components/navigation/Logo";

import { nav, navigation } from "@/config/navigation";
import site from "@/config/site";
import contact from "@/config/contact";
import social from "@/config/social";

const whatsapp = contact?.whatsapp
  ? `https://wa.me/${String(contact.whatsapp).replace(/\D/g, "")}`
  : "";

const serviceItem = navigation?.find((item) => item.key === "services");
const solutions = serviceItem?.children ?? [];

const fleetItem = navigation?.find((item) => item.key === "fleet");
const fleetItems = fleetItem?.children ?? [];

const utilityLinks = navigation?.filter((item) => item.utility) ?? [];

const socialIcons = {
  googleBusiness: FaGoogle,
  facebook: FaFacebookF,
  instagram: FaInstagram,
  whatsapp: FaWhatsapp,
};

// Safe Href Access - strictly using '#' as fallback if config fails
const servicesHref = nav?.services?.href ?? "#";
const aboutHref = nav?.about?.href ?? "#";
const contactHref = nav?.contact?.href ?? "#";
---

<footer class="relative overflow-hidden border-t border-border bg-surface text-text transition-colors duration-200">
  
  <!-- Subtle Industrial Structural Line Grid Accent -->
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:24px_24px] opacity-30 dark:bg-[radial-gradient(#1f2937_1px,transparent_1px)]"></div>

  <!-- Heavy Mobilization Engineering Banner -->
  <section class="relative border-b border-border bg-gradient-to-r from-surface-elevated/80 via-surface/50 to-surface-elevated/80 py-12 backdrop-blur-md">
    <Container>
      <div class="flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3.5 py-1 text-xs font-semibold tracking-wider text-primary uppercase">
            <ShieldCheck size={14} className="shrink-0" />
            <span>Heavy Machinery & Marine Engineering</span>
          </div>
          <h2 class="mt-4 text-2xl font-bold tracking-tight text-text sm:text-3xl lg:text-4xl">
            Need Equipment Mobilization or Site Clearance?
          </h2>
          <p class="mt-2 text-sm text-text-muted sm:text-base">
            Heavy swamp excavators, land clearers, and dredgers engineered for swamp, marine, and civil deployment across Nigeria.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-4 shrink-0">
          <a
            href={contactHref}
            class="group inline-flex items-center gap-2.5 rounded-lg bg-primary px-6 py-3.5 text-sm font-semibold text-white shadow-lg transition-all duration-300 hover:bg-primary-hover hover:shadow-primary/25"
          >
            <span>Request For Quote</span>
            <ChevronRight size={16} className="transition-transform duration-200 group-hover:translate-x-1" />
          </a>
          <a
            href={servicesHref}
            class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-6 py-3.5 text-sm font-semibold text-text transition-all duration-200 hover:border-primary hover:text-primary dark:hover:text-primary"
          >
            Explore Services
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- Main Multi-Column Section -->
  <Container>
    <div class="relative grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-5">

      <!-- Col 1 & 2: Brand Profile & Direct Contact Info -->
      <div class="lg:col-span-2 space-y-6">
        <Logo client:load />

        <p class="max-w-md text-sm leading-relaxed text-text-muted">
          {site?.description}
        </p>

        <!-- Address & Contact Details -->
        <div class="space-y-3.5 text-sm text-text-muted pt-2">
          {contact?.address && (
            <div class="flex items-start gap-3">
              <div class="rounded-md border border-border bg-surface-elevated/50 p-2 text-primary shrink-0">
                <MapPin size={16} />
              </div>
              <span class="text-xs sm:text-sm leading-snug">{contact.address}</span>
            </div>
          )}
          {contact?.phone && (
            <div class="flex items-center gap-3">
              <div class="rounded-md border border-border bg-surface-elevated/50 p-2 text-primary shrink-0">
                <Phone size={16} />
              </div>
              <a href={`tel:${contact.phone}`} class="text-xs sm:text-sm transition-colors hover:text-primary dark:hover:text-primary font-medium">
                {contact.phone}
              </a>
            </div>
          )}
          {site?.email && (
            <div class="flex items-center gap-3">
              <div class="rounded-md border border-border bg-surface-elevated/50 p-2 text-primary shrink-0">
                <Mail size={16} />
              </div>
              <a href={`mailto:${site.email}`} class="text-xs sm:text-sm transition-colors hover:text-primary dark:hover:text-primary font-medium">
                {site.email}
              </a>
            </div>
          )}
        </div>
      </div>

      <!-- Col 3: Engineering Services -->
      <div>
        <h3 class="mb-5 text-xs font-bold uppercase tracking-widest text-text border-l-2 border-primary pl-3">
          Services
        </h3>

        <nav class="space-y-3 text-sm">
          {solutions.map((item) => (
            <a
              href={item?.href ?? "#"}
              class="group flex items-center gap-1.5 text-text-muted transition-colors hover:text-primary dark:hover:text-primary"
            >
              <ChevronRight size={14} className="opacity-0 -ml-3 transition-all duration-200 group-hover:opacity-100 group-hover:ml-0 text-primary" />
              <span>{item?.title}</span>
            </a>
          ))}
        </nav>
      </div>

      <!-- Col 4: Fleet & Equipment -->
      <div>
        <h3 class="mb-5 text-xs font-bold uppercase tracking-widest text-text border-l-2 border-primary pl-3">
          {fleetItems.length > 0 ? "Heavy Fleet" : "Company"}
        </h3>

        <nav class="space-y-3 text-sm">
          {fleetItems.length > 0
            ? fleetItems.slice(0, 6).map((item) => (
                <a
                  href={item?.href ?? "#"}
                  class="group flex items-center gap-1.5 text-text-muted transition-colors hover:text-primary dark:hover:text-primary"
                >
                  <ChevronRight size={14} className="opacity-0 -ml-3 transition-all duration-200 group-hover:opacity-100 group-hover:ml-0 text-primary" />
                  <span>{item?.title}</span>
                </a>
              ))
            : navigation
                ?.filter((item) => item.footer)
                .map((item) => (
                  <a
                    href={item?.href ?? "#"}
                    class="group flex items-center gap-1.5 text-text-muted transition-colors hover:text-primary dark:hover:text-primary"
                  >
                    <ChevronRight size={14} className="opacity-0 -ml-3 transition-all duration-200 group-hover:opacity-100 group-hover:ml-0 text-primary" />
                    <span>{item?.title}</span>
                  </a>
                ))}
        </nav>
      </div>

      <!-- Col 5: Rapid Dispatch & Socials -->
      <div class="space-y-4">
        <h3 class="mb-5 text-xs font-bold uppercase tracking-widest text-text border-l-2 border-primary pl-3">
          Tender Dispatch
        </h3>

        <p class="text-xs text-text-muted leading-relaxed">
          For urgent tender documentation, site inspection requests, or equipment lease quotes:
        </p>

        <div class="space-y-2.5 pt-1">
          {site?.email && (
            <a
              href={`mailto:${site.email}`}
              class="group flex items-center justify-between rounded-lg border border-border bg-surface-elevated/40 p-3 text-xs font-medium text-text transition-all duration-200 hover:border-primary hover:bg-primary/5 hover:text-primary dark:hover:text-primary"
            >
              <div class="flex items-center gap-2.5 truncate">
                <MessageCircle size={15} className="text-primary shrink-0" />
                <span class="truncate">{site.email}</span>
              </div>
              <ArrowUpRight size={14} className="shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </a>
          )}

          {whatsapp && (
            <a
              href={whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between rounded-lg border border-border bg-surface-elevated/40 p-3 text-xs font-medium text-text transition-all duration-200 hover:border-emerald-500/50 hover:bg-emerald-500/5 hover:text-emerald-500"
            >
              <div class="flex items-center gap-2.5">
                <FaWhatsapp size={15} className="text-emerald-500 shrink-0" />
                <span>WhatsApp Desk</span>
              </div>
              <ArrowUpRight size={14} className="shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </a>
          )}
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="flex flex-col gap-6 border-t border-border py-8 md:flex-row md:items-center md:justify-between">
      <!-- Left Side: Copyright & Engineering Credit -->
      <div class="flex flex-col gap-1 text-xs text-text-muted sm:flex-row sm:items-center sm:gap-2">
        <span>{site?.copyright}</span>
        
        {site?.engineeredBy && (
          <>
            <span class="hidden text-border sm:inline">•</span>
            <span>
              {site.engineeredBy.label}{" "}
              <a
                href={site.engineeredBy.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-text-muted transition-colors hover:text-primary dark:hover:text-primary underline underline-offset-2"
              >
                {site.engineeredBy.name}
              </a>
            </span>
          </>
        )}
      </div>

      <!-- Right Side: Utility Links & Social Icons -->
      <div class="flex flex-wrap items-center gap-6 text-xs">
        <!-- Utility / Legal Links -->
        <div class="flex flex-wrap items-center gap-4">
          {utilityLinks.map((item) => {
            const href = item?.href ?? "#";
            const hasExtension = /\.[^/]+$/.test(href);

            return (
              <a
                href={href}
                target={hasExtension ? "_blank" : "_self"}
                rel={hasExtension ? "noopener noreferrer" : ""}
                class="text-text-muted transition-colors hover:text-primary dark:hover:text-primary"
              >
                {item?.title}
              </a>
            );
          })}
        </div>

        <!-- Social Icons -->
        {social && Object.keys(social).length > 0 && (
          <div class="flex w-full items-center gap-2.5 border-t border-border pt-4 sm:w-auto sm:border-l sm:border-t-0 sm:pl-6 sm:pt-0">
            {Object.entries(social).map(([key, val]) => {
              if (!val) return null;

              const Icon = socialIcons[key as keyof typeof socialIcons];
              if (!Icon) return null;

              return (
                <a
                  href={val as string}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={key}
                  class="rounded-lg border border-border p-2 text-text-muted transition-all duration-200 hover:border-primary hover:bg-primary/10 hover:text-primary dark:hover:text-primary"
                >
                  <Icon size={15} />
                </a>
              );
            })}
          </div>
        )}
      </div>
    </div>

  </Container>
</footer>