---
import {
  FaInstagram,
  FaTiktok,
  FaYoutube,
  FaWhatsapp,
} from "react-icons/fa6";

import { 
  Flame,
  Waves,
  Utensils,
  MapPin, 
  ArrowUpRight, 
  ChevronRight,
  Clock,
  PhoneCall,
  ChefHat,
  CalendarCheck,
  BookOpen,
  Compass
} from "lucide-react";

import Container from "@/components/ui/Container";
import Logo from "@/components/navigation/Logo";

import { navigation } from "@/config/navigation";
import site from "@/config/site";
import contact from "@/config/contact";
import social from "@/config/social";

const whatsappUrl = contact?.whatsappHref || (contact?.phone ? `https://wa.me/${String(contact.phone).replace(/\D/g, "")}` : "");

// Dynamic Navigation Routing based on updated navigation.ts flags
const mainFooterLinks = navigation.filter((item) => item.footer);
const primaryCtaItem = navigation.find((item) => item.key === "reservation");
const blogItem = navigation.find((item) => item.key === "blogs");
const utilityLinks = navigation.filter((item) => item.utility);

// Social Icons Mapping
const socialIcons: Record<string, any> = {
  instagram: FaInstagram,
  tiktok: FaTiktok,
  youtube: FaYoutube,
  whatsapp: FaWhatsapp,
};

// Map Link
const mapsUrl = contact?.maps || "#";
---

<footer class="relative overflow-hidden border-t border-border bg-surface text-text transition-colors duration-300">
  
  <!-- Subtle Ember Glow Accent -->
  <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 h-48 w-full max-w-4xl bg-primary/10 blur-3xl"></div>

  <!-- Gourmet Chef's Table CTA Banner -->
  <section class="relative border-b border-border bg-surface-elevated py-12">
    <Container>
      <div class="relative overflow-hidden rounded-2xl border border-primary/20 bg-gradient-to-br from-surface-elevated via-surface to-surface-elevated p-8 sm:p-10 shadow-xl">
        
        <!-- Flame Icon Silhouette Accent -->
        <div class="pointer-events-none absolute -right-10 -top-10 text-primary/5 dark:text-primary/10">
          <Flame size={240} strokeWidth={1} />
        </div>

        <div class="relative z-10 flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
          <div class="max-w-2xl space-y-3">
            <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1 text-xs font-bold tracking-widest text-primary uppercase">
              <Flame size={14} className="animate-pulse text-primary shrink-0" />
              <span>Gourmet Woodfire Dining</span>
              <span class="text-border">•</span>
              <Waves size={14} className="text-secondary shrink-0" />
              <span>Mt. James River</span>
            </div>
            
            <h2 class="font-heading text-3xl font-extrabold tracking-tight text-text sm:text-4xl">
              Dine Knees-Deep in the River
            </h2>
            <p class="text-sm text-text-muted sm:text-base leading-relaxed">
              Experience signature Jamaican surf & turf platters prepared over traditional coal stoves and open woodfire. Limited seating available for upcoming event dates.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-4 shrink-0 w-full lg:w-auto">
            <a
              href={primaryCtaItem?.href ?? "#"}
              class="group flex-1 sm:flex-none inline-flex items-center justify-center gap-2.5 rounded-xl bg-primary px-7 py-4 text-sm font-bold text-white shadow-lg transition-all duration-300 hover:bg-primary-hover hover:scale-[1.02] hover:shadow-primary/25 transform-gpu"
            >
              <Utensils size={18} />
              <span>{primaryCtaItem?.title ?? "Reserve Platter"}</span>
              <ChevronRight size={16} className="transition-transform duration-200 group-hover:translate-x-1" />
            </a>
            
            {whatsappUrl && (
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex-1 sm:flex-none inline-flex items-center justify-center gap-2 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-6 py-4 text-sm font-bold text-emerald-600 dark:text-emerald-400 transition-all duration-200 hover:border-emerald-500 hover:bg-emerald-500/20 transform-gpu"
              >
                <FaWhatsapp size={18} className="text-emerald-500" />
                <span>Instant Chat</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Main Footer Navigation & Details Grid -->
  <Container>
    <div class="relative grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-12">

      <!-- Col 1 (5 Cols): Brand Info & Location Card -->
      <div class="lg:col-span-5 space-y-6">
        <Logo client:load />

        <p class="text-sm leading-relaxed text-text-muted max-w-md">
          {site?.description || "Street Food Saturdays brings fine culinary artistry to the natural rivers of Golden Spring. Crafted with passion by Chef Walker-Barrett."}
        </p>

        <!-- Location & Direct Phone -->
        <div class="space-y-3 text-sm text-text-muted pt-1">
          {contact?.address && (
            <a 
              href={mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-start gap-3 rounded-xl border border-border/60 bg-surface-elevated/80 p-3.5 transition-all duration-200 hover:border-primary/50 hover:bg-surface-elevated transform-gpu"
            >
              <div class="rounded-lg bg-primary/10 p-2.5 text-primary shrink-0 group-hover:bg-primary group-hover:text-white transition-colors">
                <MapPin size={18} />
              </div>
              <div class="space-y-0.5">
                <span class="block text-xs font-bold text-text uppercase tracking-wider">Mt. James River Location</span>
                <span class="text-xs text-text-muted leading-snug block">{contact.address}</span>
              </div>
            </a>
          )}

          <div class="grid grid-cols-2 gap-3 pt-1">
            {contact?.phone && (
              <a 
                href={contact.phoneHref} 
                class="flex items-center gap-2.5 rounded-lg border border-border/60 bg-surface-elevated/80 p-3 text-xs font-semibold text-text transition-all hover:border-primary hover:text-primary transform-gpu"
              >
                <PhoneCall size={15} className="text-primary shrink-0" />
                <span class="truncate">{contact.phone}</span>
              </a>
            )}

            <a 
              href={mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 rounded-lg border border-border/60 bg-surface-elevated/80 p-3 text-xs font-semibold text-text transition-all hover:border-primary hover:text-primary transform-gpu"
            >
              <Compass size={15} className="text-secondary shrink-0" />
              <span>Open Navigation</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Col 2 (3 Cols): Core Site Navigation -->
      <div class="lg:col-span-3">
        <h3 class="mb-5 flex items-center gap-2 text-xs font-extrabold uppercase tracking-widest text-text font-heading border-b border-border/80 pb-2">
          <ChefHat size={15} className="text-primary" />
          <span>Explore SFS</span>
        </h3>

        <nav class="space-y-3 text-sm">
          {mainFooterLinks.map((item) => (
            <a
              href={item.href}
              class="group flex items-center gap-2 text-text-muted transition-colors hover:text-primary transform-gpu"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-border transition-colors group-hover:bg-primary"></span>
              <span class="font-medium">{item.title}</span>
            </a>
          ))}

          {blogItem && (
            <a
              href={blogItem?.href || "#"}
              class="group flex items-center gap-2 text-text-muted transition-colors hover:text-primary pt-1 transform-gpu"
            >
              <BookOpen size={14} className="text-secondary shrink-0" />
              <span class="font-medium">{blogItem?.title || ""}</span>
            </a>
          )}
        </nav>
      </div>

      <!-- Col 3 (4 Cols): Seating Hours & Reservations Info Card -->
      <div class="lg:col-span-4">
        <div class="rounded-2xl border border-border bg-surface-elevated/90 p-5 space-y-4 shadow-sm">
          <div class="flex items-center justify-between border-b border-border pb-3">
            <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-text">
              <Clock size={15} className="text-secondary" />
              <span>Event Seating Times</span>
            </div>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-[10px] font-bold text-emerald-600 dark:text-emerald-400">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-ping"></span>
              Monthly Event
            </span>
          </div>

          <div class="space-y-2.5 text-xs text-text-muted">
            <div class="flex justify-between items-center py-1">
              <span class="font-medium text-text">1st Seating (Lunch):</span>
              <span class="font-mono text-primary font-bold">11:00 AM – 1:30 PM</span>
            </div>
            <div class="flex justify-between items-center py-1 border-t border-border/40">
              <span class="font-medium text-text">2nd Seating (Sunset):</span>
              <span class="font-mono text-primary font-bold">2:00 PM – 4:30 PM</span>
            </div>
            <div class="flex justify-between items-center py-1 border-t border-border/40">
              <span class="font-medium text-text">Private Charters:</span>
              <span class="font-semibold text-text">Custom Timings</span>
            </div>
          </div>

          <a
            href={primaryCtaItem?.href ?? "#"}
            class="group flex items-center justify-between rounded-xl bg-surface border border-border p-3 text-xs font-bold text-text transition-all hover:border-primary hover:text-primary transform-gpu"
          >
            <div class="flex items-center gap-2">
              <CalendarCheck size={14} className="text-primary" />
              <span>Book Upcoming Date</span>
            </div>
            <ArrowUpRight size={14} className="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Utility & Copyright Bar -->
    <div class="flex flex-col gap-6 border-t border-border py-8 md:flex-row md:items-center md:justify-between">
      
      <!-- Copyright & Engineering Credit -->
      <div class="flex flex-col gap-1 text-xs text-text-muted sm:flex-row sm:items-center sm:gap-2">
        <span>{site?.copyright}</span>
        
        {site?.engineeredBy && (
          <>
            <span class="hidden text-border sm:inline">•</span>
            <span>
              {site.engineeredBy.label}{" "}
              <a
                href={site.engineeredBy.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-text transition-colors hover:text-primary underline underline-offset-2"
              >
                {site.engineeredBy.name}
              </a>
            </span>
          </>
        )}
      </div>

      <!-- Legal Links & Social Icons -->
      <div class="flex flex-wrap items-center gap-6 text-xs">
        
        <!-- Utility Links -->
        <div class="flex flex-wrap items-center gap-4">
          {utilityLinks.map((item) => {
            const href = item.href ?? "#";
            const isExternal = item.external || /\.[^/]+$/.test(href);

            return (
              <a
                href={href}
                target={isExternal ? "_blank" : "_self"}
                rel={isExternal ? "noopener noreferrer" : ""}
                class="text-text-muted transition-colors hover:text-primary font-medium transform-gpu"
              >
                {item.title}
              </a>
            );
          })}
        </div>

        <!-- Social Icons -->
        {social && Object.keys(social).length > 0 && (
          <div class="flex w-full items-center gap-2 border-t border-border pt-4 sm:w-auto sm:border-l sm:border-t-0 sm:pl-6 sm:pt-0">
            {Object.entries(social).map(([key, val]) => {
              if (!val || typeof val !== 'string') return null;

              const Icon = socialIcons[key];
              if (!Icon) return null;

              return (
                <a
                  href={val}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={key}
                  class="rounded-xl border border-border bg-surface-elevated/80 p-2.5 text-text-muted transition-all duration-200 hover:border-primary hover:bg-primary/10 hover:text-primary hover:scale-105 transform-gpu"
                >
                  <Icon size={16} />
                </a>
              );
            })}
          </div>
        )}
      </div>

    </div>

  </Container>
</footer>