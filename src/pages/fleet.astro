---
import Layout from "@/layouts/Layout.astro";
import PageShell from "@/components/layout/PageShell";
import { createMeta } from "@/lib/seo/meta";

const meta = createMeta({
  title: "Heavy Equipment Fleet & Machinery",
  description:
    "Explore the heavy equipment catalog of Parkers 1st Engineering Limited. CAT Bulldozers, WILCO Swamp Excavators, Cutter Dredgers, and GROVE Cranes available for lease in Nigeria.",
  path: "/fleet",
  keywords: [
    "heavy equipment leasing Nigeria",
    "CAT bulldozer rental",
    "WILCO swamp excavator lease",
    "cutter suction dredger lease",
    "GROVE crane hire Nigeria",
    "dumper truck fleet Nigeria",
  ],
});
---

<Layout meta={meta}>
  <PageShell
    page="fleet"
    client:load
  />
</Layout>