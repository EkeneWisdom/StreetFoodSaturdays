---
import Layout from "@/layouts/Layout.astro";
import PageShell from "@/components/layout/PageShell";
import { createMeta } from "@/lib/seo/meta";

const meta = createMeta({
  title: "Engineering Services & Equipment Fleet",
  description:
    "Explore the 12 specialized services offered by Parkers 1st Engineering Limited, including shoreline protection, dredging, civil engineering, pipeline construction, and heavy machinery leasing.",
  path: "/services",
  keywords: [
    "dredging operations Nigeria",
    "shoreline protection services",
    "piling engineering Nigeria",
    "heavy equipment leasing Nigeria",
    "CAT excavator leasing",
    "pipeline construction swamp",
    "land reclamation Nigeria",
    "jetty quay wall construction",
  ],
});
---

<Layout meta={meta}>
  <PageShell
    page="services"
    client:load
  />
</Layout>