---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/ui/Container";
import Section from "@/components/ui/Section";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import { createMeta } from "@/lib/seo/meta";
import slugify from "@/lib/slugify";
import site from "@/config/site";
import blogUrls from "@/components/blog/blogUrls";
import CollectionMenu from "@/components/blog/CollectionMenu.astro";

const allPosts = await getCollection("blog");
const publishedPosts = allPosts.filter(
  (post) => !post.data.draft && new Date(post.data.pubDate) <= new Date()
);

// Aggregate tags with post counts
const tagMap = publishedPosts.reduce((acc, post) => {
  const tags = post.data.tags || [];
  tags.forEach((tag) => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

const tags = Object.entries(tagMap)
  .map(([name, count]) => ({
    name,
    slug: slugify(name),
    count,
  }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const meta = createMeta({
  title: "Blog Tags",
  description: "Browse articles by specific tags and keywords across our entire blog archive.",
  path: blogUrls.tagsIndex(),
  keywords: ["blog tags", "topics", "keywords", "articles"],
});

const tagsCollectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Blog Tags",
  "description": "Browse all article tags and keywords.",
  "url": new URL(blogUrls.tagsIndex(), site.url).toString(),
};
---

<Layout meta={meta} schemas={[tagsCollectionSchema]}>
  <Section size="xslim" className="breadcrumbsBar">
    <Container>
      <Breadcrumbs
        items={[
          { label: "Blog", href: blogUrls.root() },
          { label: "Tags" },
        ]}
      />
    </Container>
  </Section>

  <Section>
    <Container>
      <header class="mx-auto max-w-3xl text-center">
        <h1 class="text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
          All Tags
        </h1>
        <p class="mt-4 text-base text-text-muted md:text-lg">
          Explore articles categorized by precise subtopics and technology keywords.
        </p>
        {/* Active filter: 'tags' with current active tag value */}
        <CollectionMenu activeFilter="tag" />
      </header>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {tags.map((tag) => (
          <a
            href={blogUrls.tag(tag.name)}
            class="
              group
              flex
              items-center
              justify-between
              rounded-lg
              border
              border-border
              bg-surface
              p-4
              transition-all
              duration-200
              hover:-translate-y-0.5
              hover:border-primary
              hover:shadow-sm
            "
          >
            <span class="font-medium text-text transition-colors group-hover:text-primary">
              #{tag.name}
            </span>
            <span class="rounded-full bg-border/50 px-2.5 py-0.5 text-xs font-semibold text-text-muted group-hover:bg-primary/10 group-hover:text-primary">
              {tag.count}
            </span>
          </a>
        ))}
      </div>
    </Container>
  </Section>
</Layout>