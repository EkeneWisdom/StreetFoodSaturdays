---
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";
import { Image } from "astro:assets";

import Layout from "@/layouts/Layout.astro";
import Container from "@/components/ui/Container";
import Section from "@/components/ui/Section";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";

import TableOfContents from "@/components/blog/TableOfContents.astro";
import SocialShare from "@/components/blog/SocialShare.astro";
import PostNavigation from "@/components/blog/PostNavigation.astro";
import BlogCard from "@/components/blog/BlogCard.astro";

import { createMeta } from "@/lib/seo/meta";
import site from "@/config/site";
import blogUrls from "@/components/blog/blogUrls";

type BlogPost = CollectionEntry<"blog">;

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");

  const published = allPosts.filter(
    (post) => !post.data.draft && post.data.pubDate <= new Date()
  );

  return published.map((post) => ({
    params: { slug: post.id },
    props: { post, allPublished: published },
  }));
}

interface Props {
  post: BlogPost;
  allPublished: BlogPost[];
}

const { post, allPublished } = Astro.props;
const { Content, headings } = await render(post);

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  category,
  tags = [],
  heroImage,
} = post.data;

/*  Reading Time Calculation  */
const wordsPerMinute = 200;
const wordCount =
  post.body
    ?.replace(/[#*_>`~-]/g, " ")
    .trim()
    .split(/\s+/)
    .filter(Boolean).length ?? 0;

const readingTime = Math.max(1, Math.ceil(wordCount / wordsPerMinute));

/*  Previous / Next Navigation  */
const sortedPosts = [...allPublished].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const currentIndex = sortedPosts.findIndex((item) => item.id === post.id);

const previousPost =
  currentIndex > 0 ? sortedPosts[currentIndex - 1] : undefined;
const nextPost =
  currentIndex >= 0 && currentIndex < sortedPosts.length - 1
    ? sortedPosts[currentIndex + 1]
    : undefined;

/*  Related Posts Scoring Algorithm  */
const relatedPosts = sortedPosts
  .filter((item) => item.id !== post.id)
  .map((item) => {
    const sameCategory = item.data.category === category;
    const sharedTags = item.data.tags.filter((tag) =>
      tags.includes(tag)
    ).length;

    return {
      post: item,
      score: (sameCategory ? 10 : 0) + sharedTags * 3,
    };
  })
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((item) => item.post);

/*  SEO Metadata & JSON-LD - */
const canonicalUrl = new URL(blogUrls.post(post.id), site.url).toString();

const articleOgImage = heroImage
  ? new URL(heroImage, site.url).toString()
  : undefined;

const meta = createMeta({
  title,
  description,
  path: blogUrls.post(post.id),
  keywords: [category, ...tags],
  image: articleOgImage,
});

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: description,
  url: canonicalUrl,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: {
    "@type": "Person",
    name: author || "Editorial Team",
  },
  publisher: {
    "@type": "Organization",
    name: site.name || "",
    logo: {
      "@type": "ImageObject",
      url: new URL("/favicon.svg", site.url).toString(),
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
  articleSection: category,
  keywords: tags.join(", "),
  ...(heroImage && { image: [articleOgImage] }),
};
---

<Layout meta={meta} schemas={[blogPostingSchema]}>
  <article data-pagefind-body>
    <!-- BREADCRUMBS -->
    <Section size="xslim" className="breadcrumbsBar">
      <Container>
        <Breadcrumbs
          items={[
            { label: "Blog", href: blogUrls.root() },
            { label: post.data.title },
          ]}
        />
      </Container>
    </Section>

    <!-- MAIN READING CONTAINER -->
    <Section size="slim" className="pt-12 pb-24">
      <Container>
        <div class="mx-auto max-w-2xl">
          <!-- ARTICLE HEADER -->
          <header class="mb-10">
            <div class="flex items-center gap-2 text-sm font-medium text-text-muted">
              <a
                href={blogUrls.category(category)}
                class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary hover:bg-primary/20"
              >
                {category}
              </a>
              <span aria-hidden="true" class="text-border">•</span>
              <span>{readingTime} min read</span>
            </div>

            <!-- Title: Larger size & cleaner leading -->
            <h1
              class="mt-6 text-3xl font-extrabold tracking-tight text-text-main sm:text-4xl md:text-5xl md:leading-[1.12]"
              data-pagefind-meta="title"
            >
              {title}
            </h1>

            <!-- Hidden Pagefind Filters -->
            <div class="hidden">
              <span data-pagefind-filter="category">{category}</span>
              {
                tags.map((tag: string) => (
                  <span data-pagefind-filter="tag">
                    {tag}
                  </span>
                ))
              }
            </div>

            <!-- Subtitle/Description: Larger, spacious text -->
            <p
              class="mt-6 text-xl leading-relaxed text-text-muted font-serif md:text-2xl"
              data-pagefind-meta="description"
            >
              {description}
            </p>

            <!-- Author & Metadata Line -->
            <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-b border-border/80 pb-8">
              <div class="flex items-center gap-3">
                <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary/10 text-base font-bold text-primary">
                  {author.charAt(0)}
                </div>
                <div class="text-sm">
                  <p class="font-semibold text-text-main">{author}</p>
                  <div class="flex items-center gap-2 text-xs text-text-muted">
                    <time datetime={pubDate.toISOString()}>
                      {
                        pubDate.toLocaleDateString("en-US", {
                          day: "numeric",
                          month: "short",
                          year: "numeric",
                        })
                      }
                    </time>
                    {
                      updatedDate && (
                        <>
                          <span aria-hidden="true">•</span>
                          <span>
                            Updated{" "}
                            {updatedDate.toLocaleDateString("en-US", {
                              day: "numeric",
                              month: "short",
                            })}
                          </span>
                        </>
                      )
                    }
                  </div>
                </div>
              </div>

              <!-- Top Quick Social Share -->
              <SocialShare title={title} url={canonicalUrl} layout="row" />
            </div>
          </header>

          <!-- HERO IMAGE -->
          {
            heroImage && (
              <div class="my-10 overflow-hidden rounded-2xl shadow-sm">
                <Image
                  src={heroImage}
                  alt={title}
                  width={1200}
                  height={630}
                  loading="eager"
                  fetchpriority="high"
                  class="h-auto w-full max-h-[520px] object-cover"
                />
              </div>
            )
          }

          <!-- TABLE OF CONTENTS -->
          {
            headings && headings.length > 0 && (
              <div class="my-10">
                <TableOfContents headings={headings} />
              </div>
            )
          }

          <!-- ARTICLE CONTENT (Upgraded Typography Scaling & Margins) -->
          <main class="my-12">
            <div class="prose prose-lg dark:prose-invert max-w-none blog-content">
              <Content />
            </div>
          </main>

          <!-- POST FOOTER -->
          <footer class="mt-16 space-y-10 border-t border-border/80 pt-10">
            <!-- Tags List -->
            {
              tags.length > 0 && (
                <div class="flex flex-wrap items-center gap-2">
                  <span class="mr-3 text-xs font-bold uppercase tracking-wider text-text-muted">
                    Tags:
                  </span>
                  {tags.map((tag: string) => (
                    <a
                      href={blogUrls.tag(tag)}
                      class="rounded-full bg-surface px-4 py-2 text-xs font-semibold text-text-muted transition-all hover:bg-border hover:text-text-main"
                    >
                      #{tag}
                    </a>
                  ))}
                </div>
              )
            }

            <!-- Bottom Share CTA Box -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-2xl border border-border p-6">
              <div>
                <p class="font-semibold text-text-main">Enjoyed reading this?</p>
                <p class="text-sm text-text-muted">Share it with your network or colleagues.</p>
              </div>
              <SocialShare title={title} url={canonicalUrl} layout="row" />
            </div>

            <!-- In-Line Previous / Next Post Navigation -->
            <div class="pt-6">
              <PostNavigation previous={previousPost} next={nextPost} />
            </div>
          </footer>
        </div>
      </Container>
    </Section>

    <!-- RELATED ARTICLES SECTION -->
    {
      relatedPosts.length > 0 && (
        <Section size="default" className="border-t border-border bg-surface/30 py-16">
          <Container>
            <div class="mb-10 text-center md:text-left">
              <p class="text-xs font-bold uppercase tracking-wider text-primary">
                Continue Reading
              </p>
              <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-text-main md:text-3xl">
                Related Articles
              </h2>
            </div>

            <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
              {relatedPosts.map((relatedPost) => (
                <BlogCard post={relatedPost} />
              ))}
            </div>
          </Container>
        </Section>
      )
    }

    <!-- BACK TO BLOG -->
    <Section size="slim" className="border-t border-border py-8">
      <Container>
        <div class="text-center md:text-left">
          <a
            href={blogUrls.root()}
            class="inline-flex items-center gap-2 text-base font-semibold text-primary hover:underline"
          >
            <span>←</span> Back to all articles
          </a>
        </div>
      </Container>
    </Section>
  </article>
</Layout>