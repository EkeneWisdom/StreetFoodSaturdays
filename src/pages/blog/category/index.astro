---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/ui/Container";
import Section from "@/components/ui/Section";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import { createMeta } from "@/lib/seo/meta";
import slugify from "@/lib/slugify";
import site from "@/config/site";
import blogUrls from "@/components/blog/blogUrls";
import CollectionMenu from "@/components/blog/CollectionMenu.astro";

const allPosts = await getCollection("blog");
const publishedPosts = allPosts.filter(
  (post) => !post.data.draft && new Date(post.data.pubDate) <= new Date()
);

// Aggregate categories with post counts
const categoryMap = publishedPosts.reduce((acc, post) => {
  const category = post.data.category;
  if (category) {
    acc[category] = (acc[category] || 0) + 1;
  }
  return acc;
}, {} as Record<string, number>);

const categories = Object.entries(categoryMap)
  .map(([name, count]) => ({
    name,
    slug: slugify(name),
    count,
  }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const meta = createMeta({
  title: "Blog Categories",
  description: "Explore our articles, guides, and insights organized by category topic.",
  path: blogUrls.categoriesIndex(),
  keywords: ["blog categories", "topics", "articles", "guides"],
});

const categoriesCollectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Blog Categories",
  "description": "Explore all article categories and topics.",
  "url": new URL(blogUrls.categoriesIndex(), site.url).toString(),
};
---

<Layout meta={meta} schemas={[categoriesCollectionSchema]}>
  <Section size="xslim" className="breadcrumbsBar">
    <Container>
      <Breadcrumbs
        items={[
          { label: "Blog", href: blogUrls.root() },
          { label: "Categories" },
        ]}
      />
    </Container>
  </Section>

  <Section>
    <Container>
      <header class="mx-auto max-w-3xl text-center">
        <h1 class="text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
          Categories
        </h1>
        <p class="mt-4 text-base text-text-muted md:text-lg">
          Browse our collection of topics to quickly find the exact insights and tutorials you need.
        </p>
        {/* Active filter: 'categories' with current active category value */}
        <CollectionMenu activeFilter="category" />
      </header>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((cat) => (
          <a
            href={blogUrls.category(cat.name)}
            class="
              group
              flex
              flex-col
              justify-between
              rounded-xl
              border
              border-border
              bg-surface
              p-6
              transition-all
              duration-200
              hover:-translate-y-1
              hover:border-primary
              hover:shadow-md
            "
          >
            <div>
              <h2 class="text-xl font-bold text-text transition-colors group-hover:text-primary">
                {cat.name}
              </h2>
              <p class="mt-2 text-sm text-text-muted">
                Explore all articles published under {cat.name}.
              </p>
            </div>
            <div class="mt-6 flex items-center justify-between pt-4 border-t border-border/60">
              <span class="text-xs font-semibold uppercase tracking-wider text-primary">
                {cat.count} {cat.count === 1 ? "Article" : "Articles"}
              </span>
              <span class="text-sm font-semibold text-primary group-hover:translate-x-1 transition-transform">
                Browse &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </Section>
</Layout>