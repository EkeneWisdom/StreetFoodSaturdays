---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/ui/Container";
import Section from "@/components/ui/Section";
import Search from "@/components/blog/Search.astro";
import createMeta from "@/lib/seo/meta";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import site from "@/config/site";
import blogUrls from "@/components/blog/blogUrls";
import CollectionMenu from "@/components/blog/CollectionMenu.astro";

// Search-intent optimized SEO Metadata
const meta = createMeta({
  title: "Search Blog",
  description: "",
  keywords: [
    "",
  ],
  path: blogUrls.search(),
});

// Schema specifically designed for search functionality pages
const searchPageSchema = {
  "@context": "https://schema.org",
  "@type": "SearchResultsPage",
  "name": meta.title,
  "description": meta.description,
  "url": new URL(Astro.url.pathname, site.url).toString(),
};
---

<Layout
  meta={meta}
  schemas={[searchPageSchema]}
  organization={false}
  localBusiness={false}
>
  <Section size="xslim" className="breadcrumbsBar">
    <Container>
      <Breadcrumbs />
    </Container>
  </Section>

  <Section size="default">
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-primary">
          Blog Search
        </p>
        <h1 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">
          Find Articles & Resources
        </h1>

        {/* Active filter: 'categories' with current active category value */}
        <CollectionMenu activeFilter="search" />

      </div>
      
      <div class="mt-8">
        <Search />
      </div>
    </Container>
  </Section>

  <!-- =========================================
       BACK TO BLOG
  ========================================== -->

  <Section size="slim" className="border-t border-border">
    <Container>
      <div class="text-center">
        <a
          href={blogUrls.root()}
          class="
            inline-flex
            items-center
            font-semibold
            text-primary
            hover:underline
          "
        >
          ← Back to all articles
        </a>
      </div>
    </Container>
  </Section>

</Layout>