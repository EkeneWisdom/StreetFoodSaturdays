---
import Layout from "@/layouts/Layout.astro";
import PageShell from "@/components/layout/PageShell";
import { createMeta } from "@/lib/seo/meta";

const meta = createMeta({
  title: "Marine, Civil & Energy Services Nigeria",
  description:
    "Parkers 1st Engineering Limited (PEL) is a leading 100% indigenous engineering company in Nigeria specializing in dredging, shoreline protection, piling, civil construction, and heavy machinery leasing.",
  path: "/",
  keywords: [
    "Parkers 1st Engineering Limited",
    "dredging company Nigeria",
    "shoreline protection Nigeria",
    "heavy equipment leasing Nigeria",
    "civil engineering construction Nigeria",
    "indigenous oil and gas servicing firm",
  ],
});
---

<Layout meta={meta}>
  <PageShell
    page="home"
    client:load
  />
</Layout>


