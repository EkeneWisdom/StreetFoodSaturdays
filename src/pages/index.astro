---
import Layout from "@/layouts/Layout.astro";
import PageShell from "@/components/layout/PageShell";
import HomePage from "@/react-pages/home";
import { createMeta } from "@/lib/seo/meta";

const meta = createMeta({
  title: "Woodfire & River Dining in Golden Spring",
  description:
    "Experience Jamaica's premier riverside culinary sanctuary in Golden Spring, Mt. James. Enjoy pimento-smoked jerk chicken, grilled lobster, and cold spring water dips every Saturday.",
  path: "/",
  keywords: [
    "Street Food Saturdays",
    "Golden Spring river restaurant",
    "Jerk chicken Mt James",
    "Riverside dining Kingston Jamaica",
    "Jamaica Saturday food event",
  ],
});
---
<Layout meta={meta}>
  <PageShell
    page="home"
    client:load
  />
</Layout>