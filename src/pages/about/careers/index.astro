---
import Layout from "@/layouts/Layout.astro";
import PageShell from "@/components/layout/PageShell";
import { createMeta } from "@/lib/seo/meta";

const meta = createMeta({
  title: "Careers & Talent",
  description:
    "Join Parkers 1st Engineering Limited (PEL). Explore engineering, marine operations, heavy machinery, and administrative career opportunities in Nigeria.",
  path: "/careers",
  keywords: [
    "Engineering jobs Nigeria",
    "Parkers 1st Engineering careers",
    "Civil engineering jobs Port Harcourt",
    "Marine engineering vacancies Nigeria",
    "Dredging operations jobs",
    "Heavy equipment operator hiring",
    "Oil and gas engineering careers Nigeria",
  ],
});
---

<Layout meta={meta}>
  <PageShell
    page="careers"
    client:load
  />
</Layout>