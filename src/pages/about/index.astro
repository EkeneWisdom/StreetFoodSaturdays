---
import Layout from "@/layouts/Layout.astro";
import PageShell from "@/components/layout/PageShell";
import { createMeta } from "@/lib/seo/meta";

const meta = createMeta({
  title: "About Us",
  description:
    "Learn about Parkers 1st Engineering Limited (PEL), a 100% indigenous Nigerian engineering firm specializing in civil construction, shoreline protection, dredging, and heavy equipment leasing.",
  path: "/about",
  keywords: [
    "Parkers 1st Engineering Limited",
    "PEL engineering Nigeria",
    "indigenous engineering company Nigeria",
    "civil construction Nigeria",
    "shoreline protection Nigeria",
    "dredging and land reclamation",
    "heavy equipment leasing Nigeria",
    "Nigerian Local Content Act compliance",
    "marine engineering services",
  ],
});
---

<Layout meta={meta}>
  <PageShell
    page="about"
    client:load
  />
</Layout>