---
import Layout from "@/layouts/Layout.astro";
import PageShell from "@/components/layout/PageShell";
import { createMeta } from "@/lib/seo/meta";

const meta = createMeta({
  title: "Engineering Projects & Case Studies",
  description:
    "Explore case studies of executed dredging, river channel reclamation, civil road construction, and industrial piping contracts executed by Parkers 1st Engineering Limited in Nigeria.",
  path: "/projects",
  keywords: [
    "dredging projects Nigeria",
    "River Niger sand reclamation",
    "civil engineering case studies Awka",
    "industrial pipeline reticulation Nigeria",
    "swamp clearing projects Niger Delta",
  ],
});
---

<Layout meta={meta}>
  <PageShell
    page="projects"
    client:load
  />
</Layout>