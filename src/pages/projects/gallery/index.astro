---
import Layout from "@/layouts/Layout.astro";
import PageShell from "@/components/layout/PageShell";
import { createMeta } from "@/lib/seo/meta";

const meta = createMeta({
  title: "Engineering Gallery & Equipment Operations",
  description:
    "View field operations, heavy equipment mobilization, marine dredging projects, and civil engineering infrastructure solutions across Nigeria.",
  path: "/projects/gallery",
  keywords: [
    "Parkers 1st engineering gallery",
    "dredging equipment photos Nigeria",
    "swamp excavator mobilization photos",
    "heavy equipment fleet showcase",
    "marine civil engineering Nigeria",
  ],
});
---

<Layout meta={meta}>
  <PageShell
    page="gallery"
    client:load
  />
</Layout>