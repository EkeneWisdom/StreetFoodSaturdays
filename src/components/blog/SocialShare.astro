---
import {
  Link,
  MessageCircle,
} from "lucide-react";

import {
  FaLinkedin,
  FaFacebookF,
  FaTwitter,
} from "react-icons/fa6";

interface Props {
  title: string;
  url: string;
  layout?: "row" | "col";
}

const { title, url, layout = "row" } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const shares = [
  {
    label: "Share on WhatsApp",
    href: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
    icon: MessageCircle,
  },
  {
    label: "Share on Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    icon: FaFacebookF,
  },
  {
    label: "Share on LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    icon: FaLinkedin,
  },
  {
    label: "Share on X",
    href: `https://x.com/intent/post?text=${encodedTitle}&url=${encodedUrl}`,
    icon: FaTwitter,
  },
];
---

<div
  class:list={[
    "flex items-center gap-2",
    layout === "col" ? "flex-col" : "flex-row",
  ]}
>
  {shares.map((share) => {
    const Icon = share.icon;

    return (
      <a
        href={share.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={share.label}
        title={share.label}
        class="flex h-10 w-10 items-center justify-center rounded-sm border border-border bg-surface text-text-muted transition hover:border-primary hover:text-primary"
      >
        <Icon size={18} />
      </a>
    );
  })}

  <button
    type="button"
    aria-label="Copy article link"
    title="Copy article link"
    data-copy-url={url}
    class="flex h-10 w-10 items-center justify-center rounded-sm border border-border bg-surface text-text-muted transition hover:border-primary hover:text-primary"
  >
    <Link size={18} />
  </button>
</div>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy-url]")
    .forEach((button) => {
      button.addEventListener("click", async () => {
        const url = button.dataset.copyUrl;

        if (!url) return;

        try {
          await navigator.clipboard.writeText(url);

          button.setAttribute("title", "Copied!");

          setTimeout(() => {
            button.setAttribute(
              "title",
              "Copy article link",
            );
          }, 1500);
        } catch {
          button.setAttribute(
            "title",
            "Unable to copy",
          );
        }
      });
    });
</script>