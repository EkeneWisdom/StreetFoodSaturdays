---
interface Props {
  currentPage: number;
  lastPage: number;
  prevUrl?: string;
  nextUrl?: string;
  baseUrl?: string;
}

const {
  currentPage,
  lastPage,
  prevUrl,
  nextUrl,
  baseUrl = "/blog",
} = Astro.props;

/* Page Range Calculation */
function getPageNumbers(current: number, last: number) {
  const delta = 1;
  const range: (number | string)[] = [];
  const rangeWithDots: (number | string)[] = [];
  let l: number | undefined;

  for (let i = 1; i <= last; i++) {
    if (i === 1 || i === last || (i >= current - delta && i <= current + delta)) {
      range.push(i);
    }
  }

  for (const i of range) {
    if (l) {
      if (typeof i === "number" && i - l === 2) {
        rangeWithDots.push(l + 1);
      } else if (typeof i === "number" && i - l !== 1) {
        rangeWithDots.push("...");
      }
    }
    rangeWithDots.push(i);
    if (typeof i === "number") {
      l = i;
    }
  }

  return rangeWithDots;
}

const visiblePages = getPageNumbers(currentPage, lastPage);

// Helper to ensure standard clean URL paths
const getPageUrl = (pageNumber: number) => {
  const cleanBase = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
  return pageNumber === 1 ? cleanBase : `${cleanBase}/page/${pageNumber}`;
};
---

{lastPage > 1 && (
  <nav
    aria-label="Blog pagination"
    class="mt-12 flex flex-wrap items-center justify-center gap-2"
  >
    <!-- PREVIOUS BUTTON -->
    {prevUrl ? (
      <a
        href={prevUrl}
        class="
          inline-flex
          h-10
          items-center
          justify-center
          gap-1
          rounded-xl
          border
          border-border
          bg-surface
          px-4
          text-sm
          font-medium
          text-text-main
          transition-all
          hover:border-primary/50
          hover:text-primary
          focus:outline-none
          focus:ring-2
          focus:ring-primary/20
        "
        aria-label="Go to previous page"
      >
        <span>←</span>
        <span>Previous</span>
      </a>
    ) : (
      <span
        class="
          inline-flex
          h-10
          cursor-not-allowed
          items-center
          justify-center
          gap-1
          rounded-xl
          border
          border-border/50
          bg-surface/50
          px-4
          text-sm
          font-medium
          text-text-muted/50
        "
        aria-disabled="true"
      >
        <span>←</span>
        <span>Previous</span>
      </span>
    )}

    <!-- NUMERIC PAGES -->
    <div class="flex items-center gap-1.5">
      {visiblePages.map((pageItem) => {
        if (pageItem === "...") {
          return (
            <span class="inline-flex h-10 w-10 items-center justify-center text-sm text-text-muted">
              …
            </span>
          );
        }

        const pageNumber = pageItem as number;
        const href = getPageUrl(pageNumber);
        const isCurrent = pageNumber === currentPage;

        return (
          <a
            href={href}
            aria-current={isCurrent ? "page" : undefined}
            aria-label={`Page ${pageNumber}`}
            class:list={[
              "inline-flex",
              "h-10",
              "w-10",
              "items-center",
              "justify-center",
              "rounded-xl",
              "border",
              "text-sm",
              "font-semibold",
              "transition-all",
              "focus:outline-none",
              "focus:ring-2",
              "focus:ring-primary/20",
              isCurrent
                ? "border-primary bg-primary text-primary-foreground shadow-sm"
                : "border-border bg-surface text-text-main hover:border-primary/50 hover:text-primary",
            ]}
          >
            {pageNumber}
          </a>
        );
      })}
    </div>

    <!-- NEXT BUTTON -->
    {nextUrl ? (
      <a
        href={nextUrl}
        class="
          inline-flex
          h-10
          items-center
          justify-center
          gap-1
          rounded-xl
          border
          border-border
          bg-surface
          px-4
          text-sm
          font-medium
          text-text-main
          transition-all
          hover:border-primary/50
          hover:text-primary
          focus:outline-none
          focus:ring-2
          focus:ring-primary/20
        "
        aria-label="Go to next page"
      >
        <span>Next</span>
        <span>→</span>
      </a>
    ) : (
      <span
        class="
          inline-flex
          h-10
          cursor-not-allowed
          items-center
          justify-center
          gap-1
          rounded-xl
          border
          border-border/50
          bg-surface/50
          px-4
          text-sm
          font-medium
          text-text-muted/50
        "
        aria-disabled="true"
      >
        <span>Next</span>
        <span>→</span>
      </span>
    )}
  </nav>
)}