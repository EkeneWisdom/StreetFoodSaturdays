{
  "name": "streetfoodsat",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "clean": "node -e \"const fs = require('fs'); ['dist', 'public/_pagefind'].forEach(p => fs.rmSync(p, { recursive: true, force: true }))\"",
    "prebuild": "npm run clean && npm run generate:seo",
    "preview": "astro preview",
    "astro": "astro",
    "build": "astro build",
    "generate:seo": "tsx --tsconfig tsconfig.scripts.json scripts/generate-seo.ts",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.2.5",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.2.2",
    "astro-pagefind": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.126.0"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "tsx": "^4.23.12",
    "vite-plugin-svgr": "^5.2.0"
  },
  "optionalDependencies": {
    "@cloudflare/workerd-windows-64": "^1.20260826.1"
  }
}
